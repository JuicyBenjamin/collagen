{
  "name": "collagen",
  "version": "0.1.0-alpha",
  "private": true,
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=26.4",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "oxlint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "oxfmt",
    "prepare": "effect-tsgo patch --typescript --no-oxlint",
    "release": "pnpm --filter @collagen/cli publish --access public --no-git-checks",
    "release-please": "node scripts/release.mjs"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@effect/tsgo": "catalog:",
    "@tanstack/intent": "0.5.6",
    "oxlint": "1.76.0",
    "oxfmt": "catalog:",
    "release-please": "^17.11.2",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "pnpm": {
    "overrides": {
      "exact-mirror": "^0.2.7"
    },
    "onlyBuiltDependencies": [
      "sodium-native",
      "udx-native",
      "esbuild"
    ]
  }
}
