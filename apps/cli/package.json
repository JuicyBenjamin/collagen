{
  "name": "@collagen/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "collagen": "src/index.tsx"
  },
  "scripts": {
    "dev": "node --experimental-ffi --import tsx src/index.tsx",
    "dev:net": "tsx src/dev-testnet.ts",
    "start": "node --experimental-ffi --import tsx src/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@collagen/p2p": "workspace:*",
    "@effect/atom-react": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "@toon-format/toon": "^4.1.1",
    "callscript": "^0.1.0",
    "effect": "4.0.0-rc.112",
    "react": "catalog:"
  },
  "devDependencies": {
    "@collagen/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "hyperdht": "^6.33.2",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
