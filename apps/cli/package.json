{
  "name": "@collagen/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "collagen": "src/index.tsx"
  },
  "scripts": {
    "dev": "node --experimental-ffi --import tsx src/index.tsx",
    "dev:net": "tsx src/dev-testnet.ts",
    "start": "node --experimental-ffi --import tsx src/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@collagen/p2p": "workspace:*",
    "@effect-atom/atom-react": "0.7.0",
    "@effect/ai": "0.37.0",
    "@effect/cli": "0.77.0",
    "@effect/experimental": "^0.61.1",
    "@effect/platform": "0.97.1",
    "@effect/platform-node": "0.108.1",
    "@effect/rpc": "^0.76.2",
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "effect": "3.22.1",
    "react": "catalog:"
  },
  "devDependencies": {
    "@collagen/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "hyperdht": "^6.33.2",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
