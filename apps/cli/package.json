{
  "name": "@collagen/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "collagen": "src/index.tsx"
  },
  "scripts": {
    "dev": "node --experimental-ffi --import tsx src/index.tsx",
    "dev:net": "tsx src/dev-testnet.ts",
    "start": "node --experimental-ffi --import tsx src/index.tsx",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .turbo node_modules"
  },
  "dependencies": {
    "@collagen/p2p": "workspace:*",
    "@effect-atom/atom-react": "0.5.0",
    "@effect/ai": "0.36.0",
    "@effect/cli": "0.75.2",
    "@effect/experimental": "^0.60.0",
    "@effect/platform": "0.96.2",
    "@effect/platform-node": "0.107.0",
    "@effect/rpc": "^0.75.1",
    "@opentui/core": "catalog:",
    "@opentui/react": "catalog:",
    "effect": "3.21.4",
    "react": "catalog:"
  },
  "devDependencies": {
    "@collagen/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "hyperdht": "^6.32.0",
    "tsx": "^4.22.4",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
